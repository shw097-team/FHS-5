+                          "pack_manifest_sha256": R.PACK_PIN,
+                          "files": [entry("a.txt", b"a")]})
+        v = R.verify_delivery(wrong_schema, pins)
+        self.assertFalse(v["ok"])
+        self.assertEqual(v["first_fail"], "SCHEMA_INVALID")
