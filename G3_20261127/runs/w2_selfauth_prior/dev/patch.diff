+        v = R.verify_delivery(wrong_bytes, pins)
+        self.assertFalse(v["ok"])
+        self.assertEqual(v["first_fail"], "BYTES_MISMATCH")
+
+    # ---- J1-T04 -------------------------------------------------------
+    def test_j1_t04_root_confinement(self):
+        outside = self.work / "outside"
