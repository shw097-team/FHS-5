+def _read_bounded(p: Path, limit: int):
+    """Read at most *limit* bytes; return (data, size) or (None, size>limit)."""
+    chunks = []
+    total = 0
+    with open(p, "rb") as fh:
+        while True:
+            chunk = fh.read(1024 * 1024)
+            if not chunk:
+                break
+            total += len(chunk)
+            if total > limit:
+                return None, total
+            chunks.append(chunk)
+    return b"".join(chunks), total
