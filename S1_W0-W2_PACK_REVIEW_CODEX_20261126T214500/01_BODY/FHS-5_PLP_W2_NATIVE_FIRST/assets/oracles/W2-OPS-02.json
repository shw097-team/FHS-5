{
  "schema": "FHS5.PLP.W2.Oracle@1",
  "status": "AUTHOR_DESIGN_INPUT_NOT_PRODUCT_ORACLE",
  "frozen_before_run": true,
  "subject": "FHS-5_PLP/W2/CONTROL_PACK",
  "scope": "W2-NF-01",
  "checker_route": "DISTINCT_SESSION_OR_WORKTREE",
  "case_id": "W2-OPS-02",
  "kind": "NEG",
  "pass_predicate": "rejected_with_RECOVERY_KIND_MISMATCH and host_effect_count == 0 and git_not_executed",
  "required_observations": [
    "recovery_kind",
    "effect_count",
    "git_execution_probe",
    "target_unchanged"
  ],
  "expected_tokens": [
    "RECOVERY_KIND_MISMATCH"
  ],
  "forbidden_tokens": [
    "OPS_RECOVERED_BY_GIT"
  ],
  "fail_if": [
    "git executed",
    "world changed",
    "token drift"
  ],
  "raw_schema": [
    "rejection_receipt",
    "target_hashes",
    "spy_log"
  ],
  "not_covered": [
    "other hosts"
  ]
}
