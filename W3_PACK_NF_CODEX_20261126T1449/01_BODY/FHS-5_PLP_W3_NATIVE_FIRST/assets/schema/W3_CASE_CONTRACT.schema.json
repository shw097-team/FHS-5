{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FHS5.PLP.W3.CaseContract.NF@1",
  "title": "W3 case contract (design projection)",
  "type": "object",
  "required": [
    "case_id",
    "kind",
    "requirement_refs",
    "fixture",
    "oracle",
    "runner",
    "expected",
    "observed",
    "verdict",
    "not_covered",
    "consumer"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^W3-[A-Z0-9]+-[0-9]+$"
    },
    "kind": {
      "enum": [
        "POS",
        "NEG",
        "EDGE",
        "SEC"
      ]
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "fixture": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ]
    },
    "oracle": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ]
    },
    "runner": {
      "type": "object",
      "required": [
        "ref",
        "argv",
        "cwd",
        "timeout_s"
      ]
    },
    "expected": {
      "type": "object",
      "required": [
        "exit",
        "token",
        "predicate"
      ]
    },
    "observed": {
      "type": "null"
    },
    "verdict": {
      "const": "NOT_RUN"
    },
    "not_covered": {
      "type": "string"
    },
    "consumer": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
